# =============================================================
# FNP Knowledge Base — template de variáveis de ambiente
# Copie para .env e preencha com os valores reais.
# NUNCA commitar o .env (já está no .gitignore).
# =============================================================

# ── Banco de dados (DO Managed PostgreSQL) ───────────────────
DB_HOST=
DB_PORT=25060
DB_NAME=defaultdb
DB_SSL=require

# Senhas por role (privilégio mínimo — ver scripts/sql/01_setup_banco.sql)
DB_PASS_ADMIN=
DB_PASS_APP_WRITE=
DB_PASS_INGESTOR=
DB_PASS_NUCLEO_CARGA=
DB_PASS_READONLY=

# ── DigitalOcean Spaces (S3-compatível) ──────────────────────
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=fnp-knowledge-base
DO_SPACES_REGION=nyc3
DO_SPACES_ENDPOINT=

# ── Google Drive API ─────────────────────────────────────────
# Caminho para o JSON da service account (o arquivo em si fica fora do git)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# ── OpenAI (embeddings) ──────────────────────────────────────
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Anthropic (respostas) ────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
