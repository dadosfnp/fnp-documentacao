# =============================================================
# FNP Knowledge Base — template de variáveis de ambiente
# Copie para .env e preencha com os valores reais.
# NUNCA commitar o .env (já está no .gitignore).
# =============================================================

# ── Banco do RAG (DO Managed PostgreSQL — database fnp_rag) ──
DB_HOST=
DB_PORT=25060
DB_NAME=fnp_rag
DB_SSL=require

# Senhas por role do fnp_rag (privilégio mínimo — ver scripts/sql/01_setup_banco.sql)
DB_PASS_ADMIN=
DB_PASS_APP_WRITE=
DB_PASS_INGESTOR=
DB_PASS_READONLY=

# ── Federação (postgres_fdw): senhas dos roles SÓ-LEITURA das fontes ─────────
# Usadas nos USER MAPPINGS do fnp_rag para ler os outros bancos (RDA-008).
# Cada fonte é um database no mesmo cluster/host acima.
FDW_FNP_SISTEMA_RO_PASS=
FDW_IFEM_RO_PASS=
FDW_NUCLEO_RO_PASS=

# ── DigitalOcean Spaces (S3-compatível) ──────────────────────
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=fnp-knowledge-base
DO_SPACES_REGION=nyc3
DO_SPACES_ENDPOINT=

# ── Google Drive API ─────────────────────────────────────────
# Caminho para o JSON da service account (o arquivo em si fica fora do git)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# ── OpenAI (embeddings) ──────────────────────────────────────
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Anthropic (respostas) ────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
